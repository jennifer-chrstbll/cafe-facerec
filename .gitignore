# ==========================================
# 1. Environment & Credentials (CRITICAL)
# ==========================================
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
# Allow template/example files
!.env.example

# ==========================================
# 2. Python & Bytecode Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
build/
dist/
*.egg-info/

# ==========================================
