# Copy to .env next to facerec_uno_q.py on the Arduino UNO Q. Never commit .env.

# ── Database (same Supabase project as the CRM) ──────────────────────────────
# Supabase -> Project Settings -> Database -> Connection string (URI), "Session pooler"
# (works over IPv4). Replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Must equal CRM -> Pengaturan -> Perangkat -> "ID kamera kasir"
CAMERA_ID=uno-q-001

# Face webcam. Leave empty: the first webcam plugged into this board is used; the owner
# can pick another one in the CRM (Perangkat -> Kamera), which overrides this.
CAMERA_SOURCE=

# ── Face vault (KEEP A BACKUP OF THIS VALUE) ─────────────────────────────────
# 64 hex characters. Generate once:  python3 -c "import os; print(os.urandom(32).hex())"
# Every stored face is protected with this key. Losing it = every customer must be
# enrolled again. Changing it on purpose revokes all stored faces at once.
VAULT_KEY=

# ── Raspberry Pi (links the recognised face to the body seen by the area camera) ──
# http://<pi-ip>:8765/wajah   (give the Pi a fixed IP in the router)
PI_FACE_URL=http://192.168.1.20:8765/wajah
# Same long random value as FACE_TOKEN in the Pi's .env
FACE_TOKEN=
# Pi camera that sees the cashier (informational)
AREA_CAMERA_ID=CAM_1

# ── Recognition (defaults measured with scripts/evaluate.py; change only after re-evaluating) ──
MATCH_THRESHOLD=0.40
MATCH_MARGIN=0.08
VOTE_RATIO=0.60
# SESSION_FRAMES=10
# SESSION_MAX_SEC=2.5

# ── Visits (keep equal to CRM -> Pengaturan -> Kunjungan) ─────────────────────
VISIT_MAX_OPEN_HOURS=6
VISIT_REOPEN_MIN=30

# ── Performance ──────────────────────────────────────────────────────────────
# NUM_THREADS=4
# FRAME_WIDTH=640
# FRAME_HEIGHT=480
