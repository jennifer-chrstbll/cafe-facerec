# Copy to uno_q/.env on the Arduino UNO Q (next to facerec_uno_q.py). Never commit .env.

# Supabase PostgreSQL (same database as the CRM)
DATABASE_URL=postgresql://postgres:<YOUR_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres

CAMERA_ID=uno-q-001
STREAM_PORT=5001
# CAMERA_INDEX=0            # default: auto-detect /dev/video0..4
# FRAME_WIDTH=640
# FRAME_HEIGHT=480

# ── Recognition (calibrate on site, see README "Calibration") ──────────────────
MATCH_THRESHOLD=0.40        # cosine tau; from scripts/evaluate.py (FAR <= 1%)
VOTE_WINDOW=5               # last N single-frame results per face
VOTE_MIN=3                  # agreeing votes needed to decide known/unknown
REVERIFY_SEC=2.0            # re-check an already identified face every N s

# ── Quality gate ───────────────────────────────────────────────────────────────
MIN_FACE_PX=60              # smaller faces are ignored (too far from the cashier)
MAX_YAW=0.28                # ~40 deg head turn
MIN_SHARPNESS=25            # Laplacian variance of the aligned face
MIN_DET_SCORE=0.60

# ── Performance ────────────────────────────────────────────────────────────────
DET_SIZE=320                # SCRFD input width; 320 is ~3x faster than 640
NUM_THREADS=4
STREAM_FPS=15
# REC_MODEL_PATH=models/w600k_mbf_int8.onnx   # only if the whole gallery is enrolled with INT8

# ── Supabase logging ───────────────────────────────────────────────────────────
KNOWN_LOG_COOLDOWN=60       # s between logs of the same customer
UNKNOWN_LOG_COOLDOWN=10
VISIT_COOLDOWN_MIN=30       # same as the CRM VisitService
RELOAD_INTERVAL=120         # s between gallery reloads
# GALLERY_SINCE=2026-09-12  # ignore embeddings made by the old pipelines
